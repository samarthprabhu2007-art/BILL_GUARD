# Copy this file to .env.local and fill in your values.
# For Vercel production: add these in the Vercel dashboard -> Settings -> Environment Variables

# MongoDB connection string (from MongoDB Atlas or your own server)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here
